{
  "name": "@aegis-re/desktop",
  "version": "1.1.0",
  "description": "AegisRE Desktop GUI & Ghidra Decompiler Studio",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:all": "electron-builder --win portable nsis",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "io.github.aegis.desktop",
    "productName": "AegisRE Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "iammrwrath",
        "repo": "AegisRE",
        "private": true
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AegisRE Studio",
      "artifactName": "AegisRE-Studio-Setup-v${version}-win-${arch}.exe"
    },
    "portable": {
      "artifactName": "AegisRE-Studio-Portable-v${version}-win-${arch}.exe"
    }
  }
}
